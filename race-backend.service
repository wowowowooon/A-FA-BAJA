[Unit]
Description=Race Stack Backend API Server
After=network.target mosquitto.service influxdb.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/race-stack/app/backend
Environment="PATH=/opt/race-stack/app/backend/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="MOSQUITTO_HOST=localhost"
Environment="INFLUXDB_URL=http://localhost:8086"
ExecStart=/opt/race-stack/app/backend/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=10
StartLimitIntervalSec=0
StartLimitBurst=0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
